# Copy to discogs2spotify.conf, then set the correct Discogs username.
DISCOGS_USER=bradz667

# Spotify has no playlist-folder API. This is the intended logical root name.
SPOTIFY_PLAYLIST_ROOT=My_record_collection

INCLUDE_FOLDERS=
EXCLUDE_FOLDERS=For-Sale

SYNC_DELETIONS=false
DRY_RUN=true
MATCH_THRESHOLD=90
AMBIGUOUS_MATCH_ACTION=skip
MISSING_TRACK_ACTION=report
DUPLICATE_TRACK_ACTION=skip

STATE_FILE=~/.config/discogs2spotify/state.db
SPOTIFY_PUBLIC_PLAYLISTS=false
API_DELAY=1.05
SPOTIFY_API_DELAY=2.0
OAUTH_REDIRECT_URI=http://127.0.0.1:8888/callback
LOG_LEVEL=INFO
LOG_TO_FILE=false

# Discogs2Graph paths (relative to this configuration file unless absolute).
MUSIC_MAP_INPUT=data/collection.csv
MUSIC_MAP_TAXONOMY=data/taxonomy.json
MUSIC_MAP_RELATIONS=data/relations.json
MUSIC_MAP_OUTPUT=output/collection_map.json
MUSIC_MAP_REPORT=output/validation_report.json
MUSIC_MAP_AMBIGUOUS_OUTPUT=output/ambiguous_mappings.json

PLAYLIST_DESCRIPTION=true
DESCRIPTION_INCLUDE_CATALOG_NUMBER=true
DESCRIPTION_INCLUDE_FORMAT=true
DESCRIPTION_INCLUDE_GENRE=true
DESCRIPTION_INCLUDE_STYLE=true
DESCRIPTION_INCLUDE_NOTES=true
DESCRIPTION_INCLUDE_MATRIX=false
DESCRIPTION_INCLUDE_DISCOGS_URL=true
ARTWORK_IMAGE_INDEX=primary
